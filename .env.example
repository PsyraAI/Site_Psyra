# Copie para .env e ajuste. Nenhum segredo real entra no repositório.

# Ambiente: development | production
PSYRA_ENV=development

# URL pública HTTPS (obrigatória em production; no Render use a URL do serviço)
# PSYRA_PUBLIC_URL=https://seu-servico.onrender.com

# Banco local (demo/banca). Ignorado se PSYRA_DATABASE_URL estiver definido.
PSYRA_DB=backend/psyra.db

# Supabase / Postgres — Session pooler URI (Connect → Session pooler → URI).
# Preferir host *.pooler.supabase.com e sslmode=require. Nunca commitar a senha.
# PSYRA_DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Segredos — em production devem ter ≥32 caracteres aleatórios (sem prefixo dev-)
PSYRA_JWT_SECRET=troque-este-valor-por-um-segredo-longo
PSYRA_JWT_EXP_MIN=480
PSYRA_FORMS_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Conformidade
PSYRA_N_MINIMO=5
PSYRA_CEP_APROVADO=false
PSYRA_ORIGEM_DADOS=sintetico

# CORS e hosts (em production: apenas domínio público)
PSYRA_CORS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
PSYRA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Documentação OpenAPI (/docs) — desligada automaticamente em production
PSYRA_DOCS=true

# Rate limits
PSYRA_RATE_LOGIN=5/minute
PSYRA_RATE_COLETA=30/minute
PSYRA_RATE_WEBHOOK=60/minute

# Observabilidade opcional
# PSYRA_SENTRY_DSN=

# Bootstrap do primeiro superadmin (uso único; remova após criar)
# PSYRA_BOOTSTRAP_ADMIN_EMAIL=ops@suaempresa.com
# PSYRA_BOOTSTRAP_ADMIN_PASSWORD=senha-forte-com-12+
# PSYRA_BOOTSTRAP_ADMIN_NAME=Operações Psyra
